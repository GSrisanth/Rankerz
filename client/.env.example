# Rankerz Client Environment Variables (for Vercel or local overrides)
# In production on Vercel, set these in the Vercel Project Settings -> Environment Variables

# Backend API URL (points to deployed Render service)
VITE_API_URL=https://rankerz.onrender.com/api

# Backend Socket.IO Server URL (points to deployed Render origin)
VITE_SOCKET_URL=https://rankerz.onrender.com
